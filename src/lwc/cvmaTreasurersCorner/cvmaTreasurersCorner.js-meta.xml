<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>CVMA Treasurer's Corner - Monthly Financial Reports for Member Transparency with NPSP Integration</description>
    <isExposed>true</isExposed>
    <masterLabel>CVMA Treasurer's Corner</masterLabel>

    <!-- Target Configurations -->
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <!-- Design Attributes for Experience Cloud -->
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="showExportButton" type="Boolean" default="true"
                      label="Show Export Button"
                      description="Allow users to export financial reports"/>
        </targetConfig>

        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="compactView" type="Boolean" default="false"
                      label="Compact View"
                      description="Show abbreviated version for dashboard use"/>
        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>
