<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>CVMA Communication Hub - Unified interface for member communication management</description>
    <isExposed>true</isExposed>
    <masterLabel>CVMA Communication Hub</masterLabel>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="height" type="Integer" default="600" description="Height of the communication hub"/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="showRelatedCommunications" type="Boolean" default="true" description="Show communications related to this record"/>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Page,lightningCommunity__Default">
            <property name="communityMode" type="Boolean" default="true" description="Optimized for Experience Cloud communities"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
