    <decisions>
        <name>Determine_Communication_Type</name>
        <label>Determine Communication Type</label>
        <locationX>380</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Skip Communication</defaultConnectorLabel>
        <rules>
            <name>Donation_Payment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DonationRecord.npsp__Primary_Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DonationRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DonationRecord.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqual</operator>
                <rightValue>
                    <stringValue>NPSP_Membership</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Donation_Email_Content</targetReference>
            </connector>
            <label>Donation Payment</label>
        </rules>
        <rules>
            <name>Membership_Payment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DonationRecord.npsp__Primary_Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DonationRecord.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DonationRecord.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NPSP_Membership</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Membership_Payment_Content</targetReference>
            </connector>
            <label>Membership Payment</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>CommunicationType</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!DonationRecord.RecordType.DeveloperName}, "Membership"),
    "Membership Payment",
    "Donation Acknowledgment"
)</expression>
    </formulas>
    <formulas>
        <name>MembershipExpirationDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!DonationRecord.CloseDate}) + 1, MONTH({!DonationRecord.CloseDate}), DAY({!DonationRecord.CloseDate}))</expression>
    </formulas>
