<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>CVMA Post-Approval Member Record Creation Flow - Epic #7 User Story #25
Autolaunched Flow triggered by approval process to create Contact and Account records
Standard Feature Integration: Replaces custom member creation logic</description>
    <environments>Default</environments>
    <interviewLabel>CVMA Create Member Records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CVMA Create Member Records Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create Account record for new member</description>
        <name>Create_Member_Account</name>
        <label>Create Member Account</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <connector>
            <targetReference>Create_Member_Contact</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>AccountNameFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Member</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CVMA_Chapter__c</field>
            <value>
                <elementReference>$Record.Chapter_Preference__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Member_Since__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Create Contact record for new member</description>
        <name>Create_Member_Contact</name>
        <label>Create Member Contact</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <connector>
            <targetReference>Prepare_Application_ID_Collection</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Create_Member_Account</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>$Record.Applicant_First_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>$Record.Applicant_Last_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>$Record.Applicant_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>$Record.Phone__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Branch__c</field>
            <value>
                <elementReference>$Record.Service_Branch__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Status__c</field>
            <value>
                <elementReference>$Record.Service_Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Combat_Veteran__c</field>
            <value>
                <elementReference>$Record.Combat_Veteran__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Level__c</field>
            <value>
                <elementReference>$Record.Membership_Level__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Emergency_Contact_Name__c</field>
            <value>
                <elementReference>$Record.Emergency_Contact_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Emergency_Contact_Phone__c</field>
            <value>
                <elementReference>$Record.Emergency_Contact_Phone__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CVMA_Chapter__c</field>
            <value>
                <elementReference>$Record.Chapter_Preference__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Member_Since__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <description>Update membership application with Contact ID and membership ID</description>
        <name>Update_Application_with_Member_Info</name>
        <label>Update Application with Member Info</label>
        <locationX>176</locationX>
        <locationY>698</locationY>
        <connector>
            <targetReference>Add_to_Member_Campaign</targetReference>
        </connector>
        <inputAssignments>
            <field>Contact_ID__c</field>
            <value>
                <elementReference>Create_Member_Contact</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_ID__c</field>
            <value>
                <elementReference>Create_Member_Account</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_ID_Generated__c</field>
            <value>
                <elementReference>GeneratedMembershipID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Processing_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update Contact record with generated membership ID</description>
        <name>Update_Contact_with_Membership_ID</name>
        <label>Update Contact with Membership ID</label>
        <locationX>176</locationX>
        <locationY>618</locationY>
        <connector>
            <targetReference>Update_Application_with_Member_Info</targetReference>
        </connector>
        <inputAssignments>
            <field>Membership_Id__c</field>
            <value>
                <elementReference>GeneratedMembershipID</elementReference>
            </value>
        </inputAssignments>
        <inputReference>Create_Member_Contact</inputReference>
    </recordUpdates>
    <recordCreates>
        <description>Add new member to CVMA Member Campaign for Event Management integration</description>
        <name>Add_to_Member_Campaign</name>
        <label>Add to Member Campaign</label>
        <locationX>176</locationX>
        <locationY>778</locationY>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>Create_Member_Contact</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>CVMACampaignID</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Responded</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HasResponded</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CVMA_Campaign</targetReference>
        </connector>
        <object>Membership_Application__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <actionCalls>
        <description>Generate unique membership ID using CVMAMembershipAutomationController</description>
        <name>Generate_Membership_ID</name>
        <label>Generate Membership ID</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <actionName>CVMAMembershipAutomationController</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Extract_Generated_Membership_ID</targetReference>
        </connector>
        <inputParameters>
            <name>applicationIds</name>
            <value>
                <elementReference>ApplicationIdCollection</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>MembershipIdResults</assignToReference>
            <name>return</name>
        </outputParameters>
    </actionCalls>
    <assignments>
        <description>Prepare Application ID Collection for Invocable Method</description>
        <name>Prepare_Application_ID_Collection</name>
        <label>Prepare Application ID Collection</label>
        <locationX>176</locationX>
        <locationY>478</locationY>
        <assignmentItems>
            <assignToReference>ApplicationIdCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Generate_Membership_ID</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Extract generated membership ID from results</description>
        <name>Extract_Generated_Membership_ID</name>
        <label>Extract Generated Membership ID</label>
        <locationX>176</locationX>
        <locationY>538</locationY>
        <assignmentItems>
            <assignToReference>GeneratedMembershipID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MembershipIdResults[0].membershipId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Contact_with_Membership_ID</targetReference>
        </connector>
    </assignments>
    <recordLookups>
        <description>Get CVMA Campaign for member integration</description>
        <name>Get_CVMA_Campaign</name>
        <label>Get CVMA Campaign</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Member_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CVMA Chapter 20-7 Members</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <storeInVariable>CVMACampaignID</storeInVariable>
    </recordLookups>
    <variables>
        <description>Generated membership ID from automation controller</description>
        <name>GeneratedMembershipID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Application ID collection for membership ID generation</description>
        <name>ApplicationIdCollection</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Membership ID results from automation controller</description>
        <name>MembershipIdResults</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>CVMAMembershipAutomationController.MembershipIdResult</objectType>
    </variables>
    <variables>
        <description>CVMA Campaign ID for member integration</description>
        <name>CVMACampaignID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <formulas>
        <description>Generate Account name from applicant details</description>
        <name>AccountNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Applicant_First_Name__c} + " " + {!$Record.Applicant_Last_Name__c} + " - CVMA Member"</expression>
    </formulas>
</Flow>