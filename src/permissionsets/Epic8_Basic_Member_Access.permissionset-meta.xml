<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Epic #8 Basic Access for Support/Auxiliary Members - VA benefits, community resources, and crisis support</description>
    <label>Epic #8 Basic Member Access</label>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Object Permissions -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>CVMAMemberAuthenticationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CVMAEpic8Phase3Controller</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CVMANPSPFinancialController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Field Permissions -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Contact.Membership_Id__c field permissions removed due to deployment restrictions -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Email</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Phone</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Page access removed - using Lightning Web Components -->

    <!-- Tab visibility removed - tabs will be configured in Experience Cloud site settings -->
</PermissionSet>
