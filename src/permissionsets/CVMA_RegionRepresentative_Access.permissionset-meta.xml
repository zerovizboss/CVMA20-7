<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>CVMA Region Representative Access per National Bylaws Article VII - oversees all state organizations and chapters within assigned region with full regional authority</description>
    <label>CVMA Region Representative Access</label>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Region Object Permissions -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Region__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- State Organization Object Permissions - Regional oversight -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>State_Organization__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Contact Object Permissions - Regional oversight -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Campaign Object Permissions - View regional campaigns -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Campaign</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Field Permissions for Regional hierarchy -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Region__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.State_Organization__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.CEB_Position__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Level__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Administrative_Hold_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Investigation_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Apex Class Access for Regional dashboards -->
    <classAccesses>
        <apexClass>CVMAOfficerDashboardControllerOptimized</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CVMAEventManagementController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CVMANPSPFinancialController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
