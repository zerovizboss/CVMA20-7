<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>CVMA Bylaws-Based Road Captain Access - Event safety coordination, ride planning, and Campaign Member management</description>
    <label>CVMA Road Captain Access</label>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Object Permissions -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Campaign</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>CampaignMember</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>CVMAMemberAuthenticationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CVMAEventManagementController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Field Permissions - Road Captain event management access -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Level__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Email</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Phone</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Road_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- CEB Position Field -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.CEB_Position__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
