<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>CVMA Bylaws-Based Quartermaster Access - Equipment, merchandise, and inventory management</description>
    <label>CVMA Quartermaster Access</label>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Object Permissions -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>PricebookEntry</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ContentDocument</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>CVMAMemberAuthenticationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Field Permissions - Quartermaster inventory access -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Level__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Email</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Phone</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.Road_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- CEB Position Field -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Contact.CEB_Position__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Product Management Fields -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Name</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Description</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.IsActive</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Tab Permissions -->
    <tabSettings>
        <tab>Contact</tab>
        <visibility>Available</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Product2</tab>
        <visibility>Available</visibility>
    </tabSettings>
    <tabSettings>
        <tab>PricebookEntry</tab>
        <visibility>Available</visibility>
    </tabSettings>
</PermissionSet>
