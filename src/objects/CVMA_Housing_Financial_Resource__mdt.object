<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>CVMA Housing Financial Resource</label>
    <pluralLabel>CVMA Housing Financial Resources</pluralLabel>
    <visibility>Public</visibility>
    <description>Housing and financial assistance resources for veterans in crisis - managed via custom metadata for easy updates</description>
    <fields>
        <fullName>Resource_Name__c</fullName>
        <label>Resource Name</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
        <description>Program or service name (e.g., VA Home Loan Program, HUD-VASH)</description>
    </fields>
    <fields>
        <fullName>Resource_Type__c</fullName>
        <label>Resource Type</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
        <description>Type: VA Home Loan, Emergency Shelter, Financial Aid, Rental Assistance, Utility Assistance, Food Bank, CVMA Emergency Fund, etc.</description>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <label>Description</label>
        <type>LongTextArea</type>
        <length>32768</length>
        <visibleLines>5</visibleLines>
        <description>Service description and how it helps veterans</description>
    </fields>
    <fields>
        <fullName>Contact_Phone__c</fullName>
        <label>Contact Phone</label>
        <type>Phone</type>
        <description>Contact phone number (24/7 hotline for emergency services)</description>
    </fields>
    <fields>
        <fullName>Contact_Email__c</fullName>
        <label>Contact Email</label>
        <type>Email</type>
        <description>Contact email address</description>
    </fields>
    <fields>
        <fullName>Website_URL__c</fullName>
        <label>Website URL</label>
        <type>Url</type>
        <description>Resource website for more information</description>
    </fields>
    <fields>
        <fullName>Address__c</fullName>
        <label>Address</label>
        <type>TextArea</type>
        <description>Physical address (for shelters, food banks, etc.)</description>
    </fields>
    <fields>
        <fullName>Service_Area__c</fullName>
        <label>Service Area</label>
        <type>Text</type>
        <length>255</length>
        <description>Geographic coverage (National, Florida, Jacksonville, etc.)</description>
    </fields>
    <fields>
        <fullName>Eligibility_Requirements__c</fullName>
        <label>Eligibility Requirements</label>
        <type>LongTextArea</type>
        <length>1000</length>
        <visibleLines>3</visibleLines>
        <description>Veteran eligibility criteria</description>
    </fields>
    <fields>
        <fullName>Emergency_Service__c</fullName>
        <label>Emergency Service</label>
        <type>Checkbox</type>
        <defaultValue>false</defaultValue>
        <description>24/7 emergency availability</description>
    </fields>
    <fields>
        <fullName>CEB_Approval_Required__c</fullName>
        <label>CEB Approval Required</label>
        <type>Checkbox</type>
        <defaultValue>false</defaultValue>
        <description>Requires CEB approval (CVMA emergency fund, etc.)</description>
    </fields>
    <fields>
        <fullName>Is_Active__c</fullName>
        <label>Is Active</label>
        <type>Checkbox</type>
        <defaultValue>true</defaultValue>
        <description>Active status for resource</description>
    </fields>
    <fields>
        <fullName>Display_Order__c</fullName>
        <label>Display Order</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>0</scale>
        <description>Sort order for display (lower numbers appear first)</description>
    </fields>
</CustomObject>
