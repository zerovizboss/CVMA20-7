# CVMA Salesforce Connection Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git (already in .gitignore)

# Salesforce Credentials (Password + Security Token method)
SF_USERNAME=detonator@cvma20-7.org
SF_PASSWORD=your_salesforce_password_here
SF_SECURITY_TOKEN=your_security_token_here

# Salesforce Org Details (already known)
SF_INSTANCE_URL=https://cvma20-7-dev-ed.develop.my.salesforce.com
SF_API_VERSION=65.0

# Optional: Domain for sandbox/production switching
# SF_DOMAIN=test  # Use for sandboxes
# SF_DOMAIN=login # Use for production (default)
